# EarlyBird environment variables — copy to .env and fill in real values.

# --- Database ---
# Any Postgres connection string. For Neon/Supabase, keep `?sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Notifications (Phase 4) ---
# Resend API key for email notifications: https://resend.com
RESEND_API_KEY=
# Verified sender. Use "onboarding@resend.dev" for quick testing.
RESEND_FROM="EarlyBird <onboarding@resend.dev>"
# Public base URL of the deployment, used to build links in notification emails.
APP_URL="http://localhost:3000"

# --- Cron / ingest protection (Phase 5) ---
# Shared secret guarding /api/ingest and /api/notify. When set, requests must
# present it as an `x-cron-secret` header (the GitHub Actions cron sends this),
# or as `Authorization: Bearer <secret>`, or a `?secret=` query param.
# Set the SAME value as a GitHub repo secret named CRON_SECRET.
# Leave blank in local dev to allow unauthenticated manual triggering.
CRON_SECRET=

# --- Resume Tailor (Phase 6) ---
# Gemini key from https://aistudio.google.com/apikey. Server-side only: it is
# read exclusively in /api/resume/* route handlers, never shipped to the client.
# Without it the Resume Tailor tab still renders but parse/analyze return 503.
GEMINI_API_KEY=
# Optional model override. Default is gemini-3.6-flash. Note that the
# gemini-1.5-* family is retired and 404s on new keys, so don't pin to it.
GEMINI_MODEL="gemini-3.6-flash"
